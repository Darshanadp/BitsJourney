<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://www.w3.org/TR/REC-html40/loose.dtd">
<html><head><meta charset="UTF-8"></head><body><p>{% if settings.image.src is not empty %}
	{% set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}	
	{% if settings.link.href %}
		<a href="/wp-content/plugins/elementor/modules/atomic-widgets/elements/atomic-image/%7B%7B%20settings.link.href%20%7D%7D" class="{{ base_styles['link-base'] }}" target="{{ settings.link.target }}" data-interaction-id="{{ id }}" data-interactions="{{ interactions | json_encode | e('html_attr') }}">
	{% endif %}
	<img class="{{ base_styles['base'] }} {{ settings.classes | join(' ') }}" if not settings.link.href data-interaction-id="{{ id }}" data-interactions="{{ interactions | json_encode | e('html_attr') }}" endif id_attribute settings.attributes raw for attr value in settings.image src="/wp-content/plugins/elementor/modules/atomic-widgets/elements/atomic-image/%7B%7B%20value%20%7C%20e('full_url')%20%7D%7D" else e endfor>
	{% if settings.link.href %}
		</a>
	{% endif %}
{% endif %}
</p></body></html>
