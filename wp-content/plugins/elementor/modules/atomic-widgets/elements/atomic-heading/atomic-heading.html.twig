<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://www.w3.org/TR/REC-html40/loose.dtd">
<html><head><meta charset="UTF-8"></head><body><p>{% if settings.title is not empty %}
	{% set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}
	&lt;{{ settings.tag | e('html_tag') }} 
		data-interaction-id="{{ id }}" 
		class="{{ settings.classes | merge( [ base_styles.base ] ) | join(' ') }}" 
		{{ id_attribute }} 
		{{ settings.attributes | raw }}
		{% if interactions and interactions is not empty %}
    data-interactions="{{ interactions | json_encode | e('html_attr') }}"
{% endif %}
	&gt;
	{% set allowed_tags = '<b><strong><em><i><u><a><del><span><br>' %}

	{% if settings.link.href %}
		<a href="/wp-content/plugins/elementor/modules/atomic-widgets/elements/atomic-heading/%7B%7B%20settings.link.href%20%7D%7D" target="{{ settings.link.target }}" class="{{ base_styles['link-base'] }}">
			{{ settings.title | striptags(allowed_tags) | raw }}
		</a>
	{% else %}
		{{ settings.title | striptags(allowed_tags) | raw }}
	{% endif %}
	{{ settings.tag | e('html_tag') }}&gt;
{% endif %}
</span></del></a></u></i></em></strong></b></p></body></html>
