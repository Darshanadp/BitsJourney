<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN" "http://www.w3.org/TR/REC-html40/loose.dtd">
<html><head><meta charset="UTF-8"></head><body><p>{% if settings.paragraph is not empty %}
	{% set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}
		&lt;{{ settings.tag | e('html_tag') }} class="{{ settings.classes | merge( [ base_styles.base ] ) | join(' ') }}" data-interaction-id="{{ id }}" data-interactions="{{ interactions | json_encode | e('html_attr') }}" {{ id_attribute }} {{ settings.attributes | raw }}&gt;
				{% if settings.link.href %}
						<a href="/wp-content/plugins/elementor/modules/atomic-widgets/elements/atomic-paragraph/%7B%7B%20settings.link.href%20%7D%7D" target="{{ settings.link.target }}" class="{{ base_styles['link-base'] }}">
								{{ settings.paragraph | striptags(allowed_tags) | raw }}
						</a>
				{% else %}
						{{ settings.paragraph | striptags('<b><strong><em><u><ul></ul><ol><li><blockquote><a><del><span><br>') | raw }}
				{% endif %}
		{{ settings.tag | e('html_tag') }}&gt;
{% endif %}
</span></del></a></blockquote></li></ol></u></em></strong></b></p></body></html>
